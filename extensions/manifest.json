{
  "manifest_version": 3,
  "name": "Chrome Local Translator",
  "version": "1.3",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "host_permissions": [
    "http://localhost:57832/*",
    "http://localhost:50021/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Command+Shift+Y"
      },
      "description": "翻訳と音声再生を実行"
    }
  },
  "action": {
    "default_title": "翻訳して喋る (Alt+W)"
  },
  "background": {
    "service_worker": "background.js"
  }
}